# ------------------------------------------------------------
# BookFlow application
# ------------------------------------------------------------
APP_ENV=local
APP_URL=http://localhost/bookflow
FRONTEND_URL=http://localhost:5173

# ------------------------------------------------------------
# MySQL
# ------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=appointment_saas
DB_USER=root
DB_PASS=

# ------------------------------------------------------------
# JWT
# IMPORTANT:
# Generate a long random secret for production.
# Example:
# php -r "echo bin2hex(random_bytes(64)), PHP_EOL;"
# ------------------------------------------------------------
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_64_BYTE_SECRET
JWT_ISSUER=bookflow
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000

# ------------------------------------------------------------
# Encryption
# Used to encrypt Google OAuth refresh tokens at rest.
# Generate with:
# php -r "echo base64_encode(random_bytes(32)), PHP_EOL;"
# ------------------------------------------------------------
APP_ENCRYPTION_KEY=CHANGE_THIS_TO_A_BASE64_32_BYTE_KEY

# ------------------------------------------------------------
# Google Calendar OAuth
# Create a Web application OAuth client in Google Cloud.
# The redirect URI must exactly match the Google Console value.
# ------------------------------------------------------------
# SMTP email notifications
MAIL_ENABLED=true
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-16-character-app-password
MAIL_ENCRYPTION=tls
MAIL_FROM_EMAIL=your-email@gmail.com
MAIL_FROM_NAME=BookFlow

GOOGLE_CLIENT_ID=
# Sign-in with Google uses this OAuth Web Client ID. It can be the same client ID.
GOOGLE_LOGIN_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost/bookflow/api/index.php?route=calendar/callback
GOOGLE_CALENDAR_ID=primary

# OAuth scopes used by BookFlow.
GOOGLE_CALENDAR_SCOPE=https://www.googleapis.com/auth/calendar.events%20https://www.googleapis.com/auth/calendar.events.freebusy
